# Local: copy this file to .env.local and fill it in. Vercel: create the same variables in
# Project Settings > Environment Variables (see docs/deploy-vercel.md). Never commit real values.

# SUPABASE_DB_URL: REQUIRED. Postgres connection string of the Supabase project. URL-encode special characters in the
# password (e.g. "@" -> "%40"). Server-side only: never prefix with VITE_.
#   - Local: the direct host (db.<ref>.supabase.co:5432) works if your network has IPv6.
#   - VERCEL: MUST be the "Transaction pooler" string (Dashboard > Connect, host aws-0-<region>.pooler.supabase.com,
#     port 6543, user postgres.<ref>). The direct host is IPv6-only and Vercel cannot reach it.
SUPABASE_DB_URL="postgresql://postgres:MY_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY: REQUIRED for document uploads (admission documents, signed contracts):
# the server stores files in a private Supabase Storage bucket. The service_role key bypasses RLS: server-side only.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="MY_SERVICE_ROLE_KEY"
# SUPABASE_ANON_KEY: optional, used only by "npm run test:smoke" (checks that the public REST API is denied by RLS).
# SUPABASE_ANON_KEY="MY_ANON_KEY"

# SUPERADMIN_*: credentials of the SuperAdmin (Conta Mãe), created ONCE when no platform admin exists yet.
# In production (Vercel / NODE_ENV=production) the built-in default admin@admin.com.br / Admin@123 is NEVER created,
# and an existing account that still has that password cannot log in: set SUPERADMIN_PASSWORD (min. 8 chars, letters
# and numbers) before the first deploy, or run "npm run admin:password" against an existing database.
# SUPERADMIN_EMAIL="admin@your-company.com"
# SUPERADMIN_PASSWORD="choose-a-strong-password"
# SUPERADMIN_NAME="SuperAdmin Root"

# GEMINI_API_KEY: optional. Without it the AI evaluation falls back to a local heuristic that is labeled as an estimate.
# GEMINI_MODEL: optional, default gemini-3.8-flash.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL="gemini-3.8-flash"

# TRUST_PROXY: number of reverse proxies in front of the server (real client IP for rate limits). Set to 1 behind a
# load balancer / Nginx. On Vercel it is applied automatically. Leave unset when exposed directly.
# TRUST_PROXY=1

# PUBLIC_APPLY_LIMIT: max public job applications per IP per hour (default 10).
# PUBLIC_APPLY_LIMIT=10

# DB_POOL_MAX: max connections per server instance (default 10 locally, 5 on Vercel).
# DB_POOL_MAX=5
# DB_SSL_CA: PEM of the Supabase CA certificate (use "\n" for line breaks). When set, the database certificate is
# verified; otherwise TLS is used without certificate verification.
# DB_SSL_CA=

