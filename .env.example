# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE_DB_URL: REQUIRED. Postgres connection string of the Supabase project
# (Dashboard > Connect > Connection string). URL-encode special characters in the
# password (e.g. "@" -> "%40"). Server-side only: never prefix with VITE_ and never commit.
# The direct host (db.<ref>.supabase.co) is IPv6-only; on IPv4-only hosts use the
# "Session pooler" string instead.
SUPABASE_DB_URL="postgresql://postgres:MY_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# SUPERADMIN_*: credentials of the default SuperAdmin (Conta Mãe), created ONCE at startup / db:seed when no
# platform admin exists yet. If unset the built-in default admin@admin.com.br / Admin@123 is used and the server
# warns until the password is changed. ALWAYS set these (or change the password) before exposing the system.
# SUPERADMIN_EMAIL="admin@admin.com.br"
# SUPERADMIN_PASSWORD="Admin@123"
# SUPERADMIN_NAME="SuperAdmin Root"

# TRUST_PROXY: set to 1 when running behind a reverse proxy / load balancer (real client IP for rate limits).
# TRUST_PROXY=1

# PUBLIC_APPLY_LIMIT: max public job applications per IP per hour (default 10).
# PUBLIC_APPLY_LIMIT=10

# Optional Supabase keys (not used by the server today; reserved for Auth/Storage).
# The service_role key bypasses RLS: keep it server-side only.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="MY_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="MY_SERVICE_ROLE_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
